# 사진 저장소 (선택). 없으면 사진 영역만 비활성화된다.
# SERVICE_ROLE_KEY 는 서버 전용이다. 브라우저로 나가면 안 된다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=fitnote-photos
