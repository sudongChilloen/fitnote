# 앱 런타임 연결: Supabase pgbouncer 6543 (transaction 모드)
DATABASE_URL=

# 마이그레이션: Supabase 5432 (session 모드)
DIRECT_URL=

# 세션 JWT 서명. openssl rand -base64 32
