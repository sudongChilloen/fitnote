# 앱 런타임 연결: Supabase pgbouncer 6543 (transaction 모드)
DATABASE_URL=

# 마이그레이션: Supabase 5432 (session 모드)
DIRECT_URL=

# 세션 JWT 서명. openssl rand -base64 32
SESSION_SECRET=

# 사진 저장소 (선택). 없으면 사진 영역만 비활성화된다.
# SERVICE_ROLE_KEY 는 서버 전용이다. 브라우저로 나가면 안 된다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=fitnote-photos

# 푸시 알림 (선택). 세 값이 모두 있어야 켜진다. 없으면 앱 안 알림만 쌓인다.
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON 의
# project_id / client_email / private_key. private_key 는 한 줄로 넣고 개행은 \n 으로 쓴다.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# 푸시를 눌렀을 때 열 주소의 앞부분 (끝에 / 없이). 없으면 서비스 워커가 상대 경로로 연다.
APP_URL=

# 푸시 알림, 브라우저 쪽. Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)의 firebaseConfig 값이다.
# 이 값들은 브라우저로 나가는 공개 값이다. VAPID 는 클라우드 메시징 > 웹 푸시 인증서의 공개 키다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
