generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                    @id @default(uuid())
  /// *
  ///    * 트레이너가 대신 만든 회원은 이메일이 없다. 본인이 계정을 이어받을 때
  ///    * 채운다. Postgres 의 unique 인덱스는 NULL 을 서로 다른 값으로 보므로
  ///    * 미가입 회원이 여럿이어도 부딪히지 않는다.
  email                   String?                   @unique
  passwordHash            String?
  name                    String
  phone                   String?
  profileImageUrl         String?
  status                  UserStatus                @default(ACTIVE)
  lastLoginAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  aiAnalyses              AiAnalysis[]
  authSessions            AuthSession[]
  bodyRecords             BodyRecord[]
  centerMemberships       CenterMembership[]
  deviceTokens            DeviceToken[]
  dietRecords             DietRecord[]
  goals                   Goal[]
  journals                Journal[]                 @relation("JournalMember")
  journalComments         JournalComment[]          @relation("JournalCommentAuthor")
  claimCodes              MemberClaimCode[]
  memberProfile           MemberProfile?
  notifications           Notification[]
  ptContracts             PTContract[]              @relation("ContractMember")
  ptSessions              PTSession[]               @relation("PTSessionMember")
  routines                Routine[]
  trainerConnections      TrainerMemberConnection[]
  trainerProfile          TrainerProfile?
  sharingSetting          TrainerSharingSetting?
  workoutFavorites        WorkoutFavorite[]
  workoutRecords          WorkoutRecord[]
  recordedWorkoutSessions WorkoutSession[]          @relation("WorkoutSessionRecordedBy")
  workoutSessions         WorkoutSession[]

  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  deviceName String?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastUsedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Center {
  id                 String                    @id @default(uuid())
  name               String
  address            String?
  phone              String?
  description        String?
  logoUrl            String?
  status             CenterStatus              @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  invitations        CenterInvitation[]
  memberships        CenterMembership[]
  gyms               Gym[]
  notices            Notice[]
  ptContracts        PTContract[]
  ptProducts         PTProduct[]
  startedConnections TrainerMemberConnection[]

  @@index([status])
}

model CenterMembership {
  id                    String             @id @default(uuid())
  centerId              String
  userId                String
  role                  MembershipRole
  status                MembershipStatus   @default(ACTIVE)
  joinedAt              DateTime           @default(now())
  leftAt                DateTime?
  joinedViaInvitationId String?
  createdInvitations    CenterInvitation[] @relation("CreatedInvitations")
  center                Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  joinedViaInvitation   CenterInvitation?  @relation("JoinedViaInvitation", fields: [joinedViaInvitationId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  authoredNotices       Notice[]           @relation("NoticeAuthor")
  noticeReads           NoticeRead[]       @relation("NoticeReader")

  @@unique([centerId, userId])
  @@index([centerId, role])
  @@index([centerId, status])
}

model CenterInvitation {
  id                    String             @id @default(uuid())
  centerId              String
  email                 String?
  code                  String             @unique
  role                  MembershipRole
  expiresAt             DateTime
  createdAt             DateTime           @default(now())
  createdByMembershipId String
  maxUses               Int                @default(1)
  revokedAt             DateTime?
  usedCount             Int                @default(0)
  center                Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdBy             CenterMembership   @relation("CreatedInvitations", fields: [createdByMembershipId], references: [id], onDelete: Cascade)
  joinedMemberships     CenterMembership[] @relation("JoinedViaInvitation")

  @@index([centerId, role])
  @@index([expiresAt])
  @@index([createdByMembershipId])
}

model MemberProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  birthDate      DateTime?
  gender         String?
  heightCm       Decimal?
  fitnessLevel   String?
  primaryGoal    String?
  onboardingDone Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  equipment      MemberEquipment[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * 트레이너라는 신분.
///  * 센터가 아니라 사람에 붙는다. 센터에 매달아 두면 센터 없는 트레이너가 존재할
///  * 수 없고, 트레이너가 센터를 옮기는 순간 그가 쌓은 회원 관계와 알림장이 전부
///  * 끊긴다. 회원의 여정을 보여주겠다면서 여정이 이직 한 번에 사라지면 앞뒤가
///  * 맞지 않는다.
///  * 센터 소속 여부는 같은 User 의 CenterMembership 이 있는가로 따로 본다.
model TrainerProfile {
  id              String                    @id @default(uuid())
  bio             String?
  specialty       String?
  careerYears     Int?
  profileImageUrl String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  userId          String                    @unique
  displayName     String?
  dietFeedbacks   DietFeedback[]
  journals        Journal[]
  claimCodes      MemberClaimCode[]
  contracts       PTContract[]
  ptSessions      PTSession[]
  createdRoutines Routine[]                 @relation("TrainerCreatedRoutines")
  invitations     TrainerInvitation[]
  connections     TrainerMemberConnection[]
  ptPrices        TrainerPTPrice[]
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * 트레이너와 회원의 코칭 관계.
///  * PT 관계의 단 하나뿐인 진실이다. 예전에는 CenterMembership 이 자기 자신을
///  * 가리켜 담당을 표현했는데, 그러면 센터가 없으면 관계도 없고 센터를 옮기면
///  * 관계가 끊겼다.
///  * 센터 가입과는 별개다. 센터에만 등록하고 PT 는 안 받는 회원이 정상 상태여야
///  * 하는데, 예전 구조에서는 그런 사람이 "담당이 비어 있는 이상한 회원" 이었다.
model TrainerMemberConnection {
  id               String           @id @default(uuid())
  trainerProfileId String
  memberUserId     String
  status           ConnectionStatus @default(ACTIVE)
  /// *
  ///    * 이 관계가 어느 센터에서 시작됐는지. 무소속 트레이너면 null.
  ///    * 지금은 쓰지 않지만 나중에 센터가 트레이너 좌석을 결제하는 구조가 되면
  ///    * "센터가 데려온 회원인가, 트레이너가 데려온 회원인가" 를 반드시 묻게 된다.
  ///    * 그때 가서 넣으면 이미 생긴 관계들의 출처를 알 방법이 없다.
  originCenterId   String?
  startedAt        DateTime         @default(now())
  endedAt          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberUser       User             @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  originCenter     Center?          @relation(fields: [originCenterId], references: [id])
  trainerProfile   TrainerProfile   @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, memberUserId])
  @@index([memberUserId, status])
  @@index([trainerProfileId, status])
}

/// *
///  * 트레이너가 대신 만들어 둔 계정을 본인이 이어받는 코드.
///  *
///  * TrainerInvitation 에 "이 회원 전용" 표시를 더하지 않고 따로 뒀다. 두 코드는
///  * 겉모습만 같고 하는 일이 다르다. 초대 코드는 *이미 계정이 있는* 사람이
///  * 여러 번 써서 트레이너와 연결되는 것이고, 이 코드는 *계정이 없는* 사람이
///  * 딱 한 번 써서 특정 계정 하나를 통째로 가져가는 것이다.
///  *
///  * 한 모델에 섞으면 초대 코드를 다루는 모든 쿼리 — 코드 사용, 발급 목록,
///  * 취소, 사용 횟수 — 가 "이건 이어받기용이니 빼라" 를 기억해야 한다. 그중
///  * 하나만 빠뜨리면 로그인한 남이 이어받기 코드를 넣어 남의 PT 기록에 닿는다.
///  * 지켜야 할 것이 무거울수록 조건을 기억에 맡기지 않는다.
///  *
///  * 한 번 쓰면 끝이고(claimedAt), 회원 한 명에게 살아 있는 코드는 하나다.
model MemberClaimCode {
  id               String         @id @default(uuid())
  code             String         @unique
  /// * 이어받을 대상. 만들 때 PENDING 이어야 한다.
  memberUserId     String
  /// * 코드를 만든 트레이너. 누가 발급했는지 남겨 둔다.
  trainerProfileId String
  expiresAt        DateTime
  /// * 쓴 시각. 채워지면 다시 못 쓴다.
  claimedAt        DateTime?
  /// * 트레이너가 거둬들인 시각. 잘못 보냈을 때 끈다.
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  memberUser       User           @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@index([memberUserId])
  @@index([trainerProfileId])
}

/// *
///  * 트레이너가 회원을 부르는 코드.
///  * 센터 코드와 나눈 이유는 두 코드가 하는 일이 다르기 때문이다. 센터 코드는
///  * "이 센터의 회원이 된다" 이고, 트레이너 코드는 "이 트레이너에게 코칭받는다"
///  * 이다. 무소속 트레이너에게는 센터가 없어 센터 코드를 만들 수도 없다.
model TrainerInvitation {
  id               String         @id @default(uuid())
  trainerProfileId String
  code             String         @unique
  maxUses          Int            @default(50)
  usedCount        Int            @default(0)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@index([trainerProfileId])
  @@index([expiresAt])
}

model Equipment {
  id                String              @id @default(uuid())
  name              String              @unique
  category          EquipmentCategory
  description       String?
  imageUrl          String?
  isSystem          Boolean             @default(true)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  exerciseEquipment ExerciseEquipment[]
  gymEquipment      GymEquipment[]
  memberEquipment   MemberEquipment[]

  @@index([category])
  @@index([isActive])
}

model MemberEquipment {
  id          String        @id @default(uuid())
  memberId    String
  equipmentId String
  available   Boolean       @default(true)
  isCustom    Boolean       @default(false)
  customName  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  equipment   Equipment     @relation(fields: [equipmentId], references: [id])
  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, equipmentId])
  @@index([memberId, available])
  @@index([equipmentId])
}

model Gym {
  id        String         @id @default(uuid())
  centerId  String
  name      String
  address   String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  center    Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  equipment GymEquipment[]

  @@index([centerId, isActive])
}

model GymEquipment {
  id          String    @id @default(uuid())
  gymId       String
  equipmentId String
  available   Boolean   @default(true)
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  gym         Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, equipmentId])
  @@index([equipmentId])
}

model Exercise {
  id               String               @id @default(uuid())
  name             String               @unique
  bodyPart         WorkoutBodyPart
  targetMuscle     String?
  movementType     ExerciseMovementType
  difficulty       Difficulty
  description      String?
  instruction      String?
  breathing        String?
  caution          String?
  videoUrl         String?
  thumbnailUrl     String?
  isSystem         Boolean              @default(true)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  equipment        ExerciseEquipment[]
  routineExercises RoutineExercise[]
  alternativesTo   WorkoutAlternative[] @relation("AlternativeTo")
  alternativesFrom WorkoutAlternative[] @relation("AlternativeFrom")
  favorites        WorkoutFavorite[]
  workoutRecords   WorkoutRecord[]

  @@index([bodyPart, isActive])
  @@index([difficulty])
  @@index([movementType])
}

model ExerciseEquipment {
  id          String    @id @default(uuid())
  exerciseId  String
  equipmentId String
  isPrimary   Boolean   @default(false)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, equipmentId])
  @@index([equipmentId, exerciseId])
}

model WorkoutAlternative {
  id                    String          @id @default(uuid())
  exerciseId            String
  alternativeExerciseId String
  type                  AlternativeType
  priority              Int             @default(0)
  reason                String?
  alternativeExercise   Exercise        @relation("AlternativeTo", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)
  exercise              Exercise        @relation("AlternativeFrom", fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, alternativeExerciseId])
  @@index([exerciseId, type])
  @@index([alternativeExerciseId])
}

model Routine {
  id                        String            @id @default(uuid())
  userId                    String
  name                      String
  description               String?
  status                    RoutineStatus     @default(ACTIVE)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  createdByTrainerProfileId String?
  createdByTrainer          TrainerProfile?   @relation("TrainerCreatedRoutines", fields: [createdByTrainerProfileId], references: [id])
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises                 RoutineExercise[]
  workoutSessions           WorkoutSession[]

  @@index([userId, status])
  @@index([createdByTrainerProfileId])
}

model RoutineExercise {
  id           String   @id @default(uuid())
  routineId    String
  exerciseId   String
  orderIndex   Int
  targetSets   Int?
  targetReps   Int?
  targetWeight Decimal?
  restSeconds  Int?
  note         String?
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, orderIndex])
  @@index([routineId])
  @@index([exerciseId])
}

model WorkoutSession {
  id               String               @id @default(uuid())
  userId           String
  routineId        String?
  startedAt        DateTime
  endedAt          DateTime?
  durationSec      Int?
  status           WorkoutSessionStatus @default(IN_PROGRESS)
  memo             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  entryMode        WorkoutEntryMode     @default(LIVE)
  recordedByUserId String?
  /// *
  ///    * PT 수업이면 그 수업. 없으면 개인 운동.
  ///    * 운동 하나하나가 아니라 세션에 붙인다. "누가 적었나"(recordedByUserId)가
  ///    * 이미 세션 단위여서, PT 여부만 운동 단위로 두면 트레이너가 적어 준 세션에
  ///    * PT 가 아닌 운동이 섞이는 설명할 수 없는 상태가 생긴다.
  ///    * PT 를 받고 남아서 혼자 유산소를 하면 세션이 나뉜다. 하루에 세션이 여러 개인
  ///    * 것은 이미 지원한다.
  ptSessionId      String?              @unique
  records          WorkoutRecord[]
  ptSession        PTSession?           @relation(fields: [ptSessionId], references: [id])
  recordedBy       User?                @relation("WorkoutSessionRecordedBy", fields: [recordedByUserId], references: [id])
  routine          Routine?             @relation(fields: [routineId], references: [id])
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, status, entryMode])
  @@index([routineId])
  @@index([recordedByUserId, startedAt])
}

model WorkoutRecord {
  id          String         @id @default(uuid())
  sessionId   String
  exerciseId  String
  orderIndex  Int            @default(0)
  note        String?
  totalVolume Decimal?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]

  @@index([sessionId, orderIndex])
  @@index([userId, exerciseId, createdAt(sort: Desc)])
  @@index([exerciseId, createdAt])
}

model WorkoutSet {
  id          String        @id @default(uuid())
  recordId    String
  setNumber   Int
  weight      Decimal?
  reps        Int?
  restSeconds Int?
  completed   Boolean       @default(true)
  rpe         Decimal?
  note        String?
  createdAt   DateTime      @default(now())
  record      WorkoutRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, setNumber])
  @@index([recordId])
}

model WorkoutFavorite {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, createdAt])
}

model PTProduct {
  id            String           @id @default(uuid())
  centerId      String
  name          String
  description   String?
  basePrice     Decimal
  sessionCount  Int
  durationDays  Int?
  isTrial       Boolean          @default(false)
  status        PTProductStatus  @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  contracts     PTContract[]
  center        Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  trainerPrices TrainerPTPrice[]

  @@index([centerId, status])
}

/// *
///  * 수업을 미룬 이력.
///  * 상태로 만들지 않았다. 미룬 수업은 여전히 "앞으로 할 수업" 이라 SCHEDULED 로
///  * 남아야 하고, POSTPONED 같은 상태를 두면 다음 수업 목록에서 조용히 빠진다.
///  * 화면의 "🔄 일정 변경" 줄은 상태가 아니라 여기 쌓인 이력이다.
model PTSessionReschedule {
  id              String         @id @default(uuid())
  sessionId       String
  fromScheduledAt DateTime
  toScheduledAt   DateTime
  movedBy         PTSessionActor
  reason          String?
  createdAt       DateTime       @default(now())
  session         PTSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model TrainerPTPrice {
  id               String         @id @default(uuid())
  productId        String
  price            Decimal
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  trainerProfileId String
  product          PTProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, productId])
  @@index([productId])
}

model PTContract {
  id               String           @id @default(uuid())
  /// *
  ///    * 센터가 파는 상품에서 나온 계약인지. 개인 트레이너면 null.
  ///    * 예전에는 이 값이 필수였다. 그런데 PTProduct 는 센터의 것이라, 상품을
  ///    * 반드시 거치게 하면 혼자 하는 트레이너는 센터를 먼저 만들지 않고서는
  ///    * "김수정 / 20회 / 9월~12월" 조차 등록할 수 없었다. 계약이 스스로 설 수
  ///    * 있어야 한다. 이름과 횟수를 계약이 직접 든 이유다.
  productId        String?
  /// *
  ///    * 이 계약을 부르는 이름. "PT 20회", "재활 3개월" 처럼.
  ///    * 예전 이름은 productNameSnapshot 이었는데, 상품을 거치지 않게 된 지금은
  ///    * 거짓말이다. 비워 두면 횟수로 자동으로 채운다.
  title            String
  totalSessions    Int
  usedSessions     Int              @default(0)
  startedAt        DateTime
  expiresAt        DateTime?
  status           PTContractStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberUserId     String
  trainerProfileId String
  /// *
  ///    * 이 계약이 어느 센터에서 맺어졌는지. 개인 트레이너면 null.
  ///    * 관계가 시작된 센터(TrainerMemberConnection.originCenterId)와 다를 수 있다.
  ///    * 트레이너가 이직한 뒤 같은 회원과 새로 맺은 계약은 새 센터의 것이다.
  ///    * 나중에 센터가 "우리 센터에서 나간 PT" 를 셀 때 이 값이 없으면 답할 수 없다.
  centerId         String?
  center           Center?          @relation(fields: [centerId], references: [id])
  memberUser       User             @relation("ContractMember", fields: [memberUserId], references: [id])
  product          PTProduct?       @relation(fields: [productId], references: [id])
  trainerProfile   TrainerProfile   @relation(fields: [trainerProfileId], references: [id])
  sessions         PTSession[]

  @@index([memberUserId, status])
  @@index([trainerProfileId, status])
  @@index([centerId, status])
  @@index([productId])
  @@index([expiresAt])
}

model PTSession {
  id               String                @id @default(uuid())
  contractId       String
  sessionNumber    Int
  scheduledAt      DateTime
  durationMinutes  Int                   @default(60)
  status           PTSessionStatus       @default(SCHEDULED)
  memo             String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  memberUserId     String
  trainerProfileId String
  /// *
  ///    * 이 회차가 계약 횟수를 깎았는가.
  ///    * 상태에서 파생하지 않고 그때 박아 둔다. 노쇼를 차감할지는 트레이너마다
  ///    * 다르고 도중에 바뀌는데, 파생해서 세면 정책을 바꾼 순간 지난 계약의 남은
  ///    * 횟수까지 소리 없이 달라진다. 그때 어떻게 했는지는 그때 남겨야 한다.
  deducted         Boolean               @default(false)
  cancelledBy      PTSessionActor?
  /// *
  ///    * 회원이 아직 확인하지 못한 일정 변경이 있으면 그 시각. 확인하면 다시 null.
  ///    *
  ///    * 트레이너가 수업을 잡거나 옮기거나 취소하면 회원은 알 길이 없었다. 홈의
  ///    * 다가오는 수업 목록에서 시간이 조용히 바뀌고, 취소된 수업은 그냥 사라진다.
  ///    * 회원은 원래 시각에 헬스장에 간다.
  ///    *
  ///    * 별도의 알림 테이블을 두지 않은 이유는, 알림장·공지가 이미 각자 읽음을
  ///    * 들고 있어서(Journal.memberReadAt · NoticeRead) 세 번째 읽음 장부가
  ///    * 생기면 같은 사건이 한쪽에서만 지워지는 상태가 반드시 생기기 때문이다.
  ///    * 알릴 것이 수업 일정 하나뿐인 동안은 수업이 직접 들고 있는 게 맞다.
  ///    *
  ///    * 값을 지우는(=null) 방식이라 "무엇이" 바뀌었는지는 안 남지만, 그 이력은
  ///    * PTSessionReschedule 과 cancelledAt 에 이미 있다.
  memberAlertAt    DateTime?
  journals         Journal[]
  contract         PTContract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  memberUser       User                  @relation("PTSessionMember", fields: [memberUserId], references: [id])
  trainerProfile   TrainerProfile        @relation(fields: [trainerProfileId], references: [id])
  reschedules      PTSessionReschedule[]
  workoutSession   WorkoutSession?

  @@unique([contractId, sessionNumber])
  @@index([trainerProfileId, scheduledAt])
  @@index([memberUserId, scheduledAt])
  @@index([status, scheduledAt])
}

model DietRecord {
  id            String         @id @default(uuid())
  userId        String
  date          DateTime
  mealType      DietMealType
  foodName      String?
  amount        String?
  calories      Decimal?
  carbohydrate  Decimal?
  protein       Decimal?
  fat           Decimal?
  memo          String?
  aiAnalyzed    Boolean        @default(false)
  aiResult      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  imagePath     String?
  thumbnailPath String?
  feedbacks     DietFeedback[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, mealType])
}

model DietFeedback {
  id               String         @id @default(uuid())
  dietRecordId     String
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  trainerProfileId String
  dietRecord       DietRecord     @relation(fields: [dietRecordId], references: [id], onDelete: Cascade)
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id])

  @@index([dietRecordId, createdAt])
  @@index([trainerProfileId, createdAt])
}

/// *
///  * 회원이 재는 몸.
///  * 하루에 한 줄만 둔다. recordedAt 은 KST 그 날 0시로 맞춰 넣는다. 아침에 재고
///  * 저녁에 또 재면 그래프가 톱니가 되는데, 체중은 하루 안에서도 1~2kg 이 움직여서
///  * 그 톱니가 실제 변화보다 커 보인다. 같은 날 다시 적으면 덮어쓴다.
model BodyRecord {
  id               String   @id @default(uuid())
  userId           String
  recordedAt       DateTime
  weightKg         Decimal?
  bodyFatPercent   Decimal?
  skeletalMuscleKg Decimal?
  waistCm          Decimal?
  memo             String?
  imageUrl         String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedAt])
  @@index([userId, recordedAt])
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  type        GoalType
  title       String
  description String?
  targetValue Decimal?
  unit        String?
  startDate   DateTime
  targetDate  DateTime?
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  /// *
  ///    * 목표를 세울 때의 값.
  ///    * 파생하지 않고 그때 박는다. "startDate 이전의 가장 최근 기록" 으로 계산하면
  ///    * 나중에 빠뜨린 과거 기록을 하나 넣는 순간 시작값이 바뀌고, 그러면 진행률이
  ///    * 소리 없이 달라진다. 시작값은 "그때 나는 78kg 이었다" 는 사실이다.
  ///    * 지금 값은 반대로 저장하지 않는다. 최신 BodyRecord 에서 읽는다. 저장하면
  ///    * 회원이 체중을 새로 적는 순간 목표 카드만 옛날 숫자로 남는다.
  startValue  Decimal?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, targetDate])
}

model Journal {
  id               String           @id @default(uuid())
  ptSessionId      String?
  date             DateTime
  title            String?
  content          String
  status           JournalStatus    @default(DRAFT)
  workoutSummary   String?
  dietGuidance     String?
  caution          String?
  nextGoal         String?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  /// *
  ///    * 회원이 읽은 시각.
  ///    * 이게 없으면 홈의 "오늘 확인할 것" 을 고를 수 없다. 안 읽은 것을 세는 게
  ///    * 아니라 "무엇을 보여줄지" 를 정하는 데 쓴다.
  memberReadAt     DateTime?
  memberUserId     String
  trainerProfileId String
  memberUser       User             @relation("JournalMember", fields: [memberUserId], references: [id])
  ptSession        PTSession?       @relation(fields: [ptSessionId], references: [id])
  trainerProfile   TrainerProfile   @relation(fields: [trainerProfileId], references: [id])
  comments         JournalComment[]
  photos           JournalPhoto[]

  @@index([memberUserId, date])
  @@index([trainerProfileId, date])
  @@index([ptSessionId])
  @@index([status, publishedAt])
  @@index([memberUserId, memberReadAt])
}

model JournalPhoto {
  id            String   @id @default(uuid())
  journalId     String
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  /// *
  ///    * 저장소 안의 경로. 주소가 아니다.
  ///    * 비공개 버킷이라 주소는 볼 때마다 서명해서 만든다. 서명된 주소를 저장하면
  ///    * 한 시간 뒤에 죽은 값이 DB 에 남는다.
  storagePath   String
  thumbnailPath String?
  journal       Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId, orderIndex])
}

/// *
///  * 알림장 댓글.
///  * 식단 댓글(DietFeedback)과 합치지 않았다. 대상이 다른 댓글을 한 테이블에 담으려면
///  * (targetType, targetId) 로 가리켜야 하는데 그러면 외래키를 걸 수 없어서, 알림장을
///  * 지워도 댓글이 남는다.
model JournalComment {
  id           String    @id @default(uuid())
  journalId    String
  content      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  authorUserId String
  author       User      @relation("JournalCommentAuthor", fields: [authorUserId], references: [id])
  journal      Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId, createdAt])
  @@index([authorUserId])
}

/// *
///  * 공지사항.
///  * 알림장이 한 회원에게 가는 글이라면 이건 여러 명에게 간다. 대상을 회원 목록으로
///  * 펼쳐 저장하지 않는다. 회원이 늘거나 나갈 때마다 대상을 고쳐야 하기 때문이다.
///  * 대신 범위만 저장하고 읽을 때 계산한다.
model Notice {
  id                 String           @id @default(uuid())
  centerId           String
  authorMembershipId String
  scope              NoticeScope      @default(CENTER)
  title              String
  content            String
  pinnedAt           DateTime?
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  authorMembership   CenterMembership @relation("NoticeAuthor", fields: [authorMembershipId], references: [id])
  center             Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  reads              NoticeRead[]

  @@index([centerId, publishedAt])
  @@index([authorMembershipId])
}

model NoticeRead {
  id           String           @id @default(uuid())
  noticeId     String
  membershipId String
  readAt       DateTime         @default(now())
  membership   CenterMembership @relation("NoticeReader", fields: [membershipId], references: [id], onDelete: Cascade)
  notice       Notice           @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, membershipId])
  @@index([membershipId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  relatedType String?
  relatedId   String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model AiAnalysis {
  id           String           @id @default(uuid())
  userId       String
  type         String
  status       AiAnalysisStatus @default(PENDING)
  inputData    Json?
  resultData   Json?
  errorMessage String?
  createdAt    DateTime         @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
  @@index([createdAt])
}

/// *
///  * 회원이 담당 트레이너에게 무엇까지 보여줄지.
///  * 회원 계정에 붙인다. 예전에는 센터 소속에 붙였는데, 이제 코칭 관계가 센터와
///  * 무관하게 이어지므로 소속에 매달면 센터를 옮길 때마다 설정이 초기화된다.
///  * 켜 둔 줄 알았던 것이 조용히 꺼지는 쪽이, 지난 설정이 따라오는 것보다 나쁘다.
///  * 트레이너를 여럿 두게 되면 이 표가 연결(TrainerMemberConnection)로 내려간다.
///  * PT 수업 기록은 여기에 없다. 그건 트레이너가 직접 적은 것이라 회원이
///  * 가릴 대상이 아니다. 회원이 스스로 남긴 것만 고를 수 있게 한다.
model TrainerSharingSetting {
  id                   String   @id @default(uuid())
  /// *
  ///    * 식단은 기본으로 켠다.
  ///    * 회원이 식단을 올리는 이유가 대개 피드백을 받기 위해서다. 기본이 꺼져
  ///    * 있으면 올려 두고 "왜 답이 없지" 하게 된다.
  shareDiet            Boolean  @default(true)
  shareDietPhoto       Boolean  @default(true)
  /// *
  ///    * 개인 운동과 체중은 기본으로 끈다.
  ///    * 혼자 한 운동과 몸무게는 보여주려고 적는 게 아니다. 켜는 건 회원이
  ///    * 정하게 한다.
  sharePersonalWorkout Boolean  @default(false)
  shareBody            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  /// *
  ///    * 트레이너가 대신 만들어 둔 회원. 본인은 아직 계정을 이어받지 않았다.
  ///    *
  ///    * 트레이너가 회원 서른 명을 관리하려면 서른 명이 먼저 가입해야 하는 구조는
  ///    * 현실에서 굴러가지 않는다. 그중 다섯이 가입하고 나머지는 수기로 남으면
  ///    * 트레이너는 결국 둘 다 버린다. 그래서 트레이너가 이름만으로 먼저 만들고,
  ///    * 회원이 나중에 이 계정을 이어받는다.
  ///    *
  ///    * 이 계정은 로그인하지 못한다. email 과 passwordHash 가 비어 있어서
  ///    * 로그인 경로에 애초에 걸리지 않고, 상태로 한 번 더 막는다.
  PENDING
}

enum MembershipRole {
  CENTER_ADMIN
  TRAINER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
  LEFT
}

/// *
///  * 트레이너와 회원의 코칭 관계 상태.
///  * PENDING(승인 대기)을 일부러 넣지 않았다. 지금은 트레이너가 회원에게 코드를
///  * 직접 건네는 방식이라 코드를 가진 시점에 이미 승인된 것과 같다. 여기에 승인
///  * 단계를 두면 회원은 코드를 넣고도 "왜 안 되지" 하며 기다린다.
///  * 나중에 트레이너 공개 프로필에서 아무나 신청할 수 있게 되면 그때 넣는다.
enum ConnectionStatus {
  ACTIVE
  ENDED
}

enum CenterStatus {
  ACTIVE
  INACTIVE
}

enum PTProductStatus {
  ACTIVE
  INACTIVE
}

enum PTContractStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PTSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// *
///  * 취소하거나 미룬 쪽.
///  * 누가 미뤘는지는 재등록 상담에서 실제로 묻는 값이다. "회원이 자주 미뤘다"
///  * 와 "트레이너 사정으로 밀렸다" 는 완전히 다른 이야기인데, 안 남기면 나중에
///  * 둘 다 그냥 "일정 변경 3회" 로만 보인다.
enum PTSessionActor {
  MEMBER
  TRAINER
}

/// *
///  * 기록을 남긴 방식.
///  * LIVE   운동하면서 실시간으로 기록. 홈의 "진행중" 배너와 타이머가 붙는다.
///  * MANUAL 운동을 끝낸 뒤(또는 지난 날짜를) 몰아서 입력.
///  * 둘 다 편집하는 동안 IN_PROGRESS 여야 하는데, 구분이 없으면 어제 기록을
///  * 입력하는 중에 홈에 "운동 진행중" 이 뜨고 새 운동 시작이 막힌다.
/// *
///  * 공지를 누가 보는가.
///  * CENTER          센터 소속 전체
///  * TRAINER_MEMBERS 작성한 트레이너가 담당하는 회원만
enum NoticeScope {
  CENTER
  TRAINER_MEMBERS
}

enum WorkoutEntryMode {
  LIVE
  MANUAL
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoutineStatus {
  ACTIVE
  ARCHIVED
}

enum DietMealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum JournalStatus {
  DRAFT
  PUBLISHED
}

enum NotificationType {
  JOURNAL_CREATED
  PT_SESSION_REMINDER
  PT_SESSION_CHANGED
  PT_CONTRACT_EXPIRING
  GENERAL
}

enum DevicePlatform {
  WEB
  IOS
  ANDROID
}

enum GoalType {
  WEIGHT
  BODY_FAT
  MUSCLE_MASS
  WORKOUT_FREQUENCY
  EXERCISE_PR
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EquipmentCategory {
  FREE_WEIGHT
  MACHINE
  CABLE
  CARDIO
  BODYWEIGHT
  BAND
  OTHER
}

enum WorkoutBodyPart {
  CHEST
  BACK
  SHOULDER
  ARM
  LEG
  GLUTE
  ABS
  FULL_BODY
  CARDIO
  OTHER
}

enum ExerciseMovementType {
  PUSH
  PULL
  SQUAT
  HINGE
  LUNGE
  CARRY
  ROTATION
  ISOLATION
  CARDIO
  OTHER
}

enum AlternativeType {
  SAME_MUSCLE
  SAME_MOVEMENT
  EQUIPMENT_ALTERNATIVE
  DIFFICULTY_ALTERNATIVE
}

enum AiAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
