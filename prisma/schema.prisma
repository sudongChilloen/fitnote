generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum MembershipRole {
  CENTER_ADMIN
  TRAINER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
  LEFT
}

/**
 * 트레이너와 회원의 코칭 관계 상태.
 * PENDING(승인 대기)을 일부러 넣지 않았다. 지금은 트레이너가 회원에게 코드를
 * 직접 건네는 방식이라 코드를 가진 시점에 이미 승인된 것과 같다. 여기에 승인
 * 단계를 두면 회원은 코드를 넣고도 "왜 안 되지" 하며 기다린다.
 * 나중에 트레이너 공개 프로필에서 아무나 신청할 수 있게 되면 그때 넣는다.
 */
enum ConnectionStatus {
  ACTIVE
  ENDED
}

enum CenterStatus {
  ACTIVE
  INACTIVE
}

enum PTProductStatus {
  ACTIVE
  INACTIVE
}

enum PTContractStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PTSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/**
 * 취소하거나 미룬 쪽.
 * 누가 미뤘는지는 재등록 상담에서 실제로 묻는 값이다. "회원이 자주 미뤘다"
 * 와 "트레이너 사정으로 밀렸다" 는 완전히 다른 이야기인데, 안 남기면 나중에
 * 둘 다 그냥 "일정 변경 3회" 로만 보인다.
 */
enum PTSessionActor {
  MEMBER
  TRAINER
}

/**
 * 기록을 남긴 방식.
 * LIVE   운동하면서 실시간으로 기록. 홈의 "진행중" 배너와 타이머가 붙는다.
 * MANUAL 운동을 끝낸 뒤(또는 지난 날짜를) 몰아서 입력.
 * 둘 다 편집하는 동안 IN_PROGRESS 여야 하는데, 구분이 없으면 어제 기록을
 * 입력하는 중에 홈에 "운동 진행중" 이 뜨고 새 운동 시작이 막힌다.
 */
/**
 * 공지를 누가 보는가.
 * CENTER          센터 소속 전체
 * TRAINER_MEMBERS 작성한 트레이너가 담당하는 회원만
 */
enum NoticeScope {
  CENTER
  TRAINER_MEMBERS
}

enum WorkoutEntryMode {
  LIVE
  MANUAL
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoutineStatus {
  ACTIVE
  ARCHIVED
}

enum DietMealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum JournalStatus {
  DRAFT
  PUBLISHED
}

enum NotificationType {
  JOURNAL_CREATED
  PT_SESSION_REMINDER
  PT_SESSION_CHANGED
  PT_CONTRACT_EXPIRING
  GENERAL
}

enum DevicePlatform {
  WEB
  IOS
  ANDROID
}

enum GoalType {
  WEIGHT
  BODY_FAT
  MUSCLE_MASS
  WORKOUT_FREQUENCY
  EXERCISE_PR
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EquipmentCategory {
  FREE_WEIGHT
  MACHINE
  CABLE
  CARDIO
  BODYWEIGHT
  BAND
  OTHER
}

enum WorkoutBodyPart {
  CHEST
  BACK
  SHOULDER
  ARM
  LEG
  GLUTE
  ABS
  FULL_BODY
  CARDIO
  OTHER
}

enum ExerciseMovementType {
  PUSH
  PULL
  SQUAT
  HINGE
  LUNGE
  CARRY
  ROTATION
  ISOLATION
  CARDIO
  OTHER
}

enum AlternativeType {
  SAME_MUSCLE
  SAME_MOVEMENT
  EQUIPMENT_ALTERNATIVE
  DIFFICULTY_ALTERNATIVE
}

enum AiAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// USER
// ============================================================

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  name            String
  phone           String?
  profileImageUrl String?
  status          UserStatus @default(ACTIVE)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 기본 회원 프로필
  memberProfile  MemberProfile?
  trainerProfile TrainerProfile?

  // 이 사람을 코칭하는 트레이너와의 관계
  trainerConnections TrainerMemberConnection[]

  // 트레이너에게 무엇까지 보여줄지
  sharingSetting TrainerSharingSetting?

  // PT (회원 쪽)
  ptContracts PTContract[] @relation("ContractMember")
  ptSessions  PTSession[]  @relation("PTSessionMember")

  // 알림장 (회원 쪽) · 댓글은 트레이너와 회원이 같이 쓴다
  journals        Journal[]        @relation("JournalMember")
  journalComments JournalComment[] @relation("JournalCommentAuthor")

  // 인증
  authSessions AuthSession[]
  deviceTokens DeviceToken[]

  // 헬스장 가입 정보
  centerMemberships CenterMembership[]

  // 운동
  routines                Routine[]
  workoutSessions         WorkoutSession[]
  // 트레이너로서 회원을 대신해 적어 준 기록
  recordedWorkoutSessions WorkoutSession[]  @relation("WorkoutSessionRecordedBy")
  workoutRecords          WorkoutRecord[]
  workoutFavorites        WorkoutFavorite[]

  // 식단 / 신체 / 목표
  dietRecords DietRecord[]
  bodyRecords BodyRecord[]
  goals       Goal[]

  // 알림 / AI
  notifications Notification[]
  aiAnalyses    AiAnalysis[]

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AUTH SESSION
// ============================================================

model AuthSession {
  id               String @id @default(uuid())
  userId           String
  refreshTokenHash String @unique

  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// DEVICE TOKEN / FCM
// ============================================================

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  deviceName String?

  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// ============================================================
// CENTER
// ============================================================

model Center {
  id          String  @id @default(uuid())
  name        String
  address     String?
  phone       String?
  description String?
  logoUrl     String?

  status CenterStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CenterMembership[]
  invitations CenterInvitation[]

  // 이 센터에서 시작된 코칭 관계 · 이 센터에서 맺어진 PT 계약
  startedConnections TrainerMemberConnection[]
  ptContracts        PTContract[]
  ptProducts         PTProduct[]
  gyms               Gym[]
  notices            Notice[]

  @@index([status])
}

// ============================================================
// CENTER MEMBERSHIP
// ============================================================

model CenterMembership {
  id       String @id @default(uuid())
  centerId String
  userId   String

  role   MembershipRole
  status MembershipStatus @default(ACTIVE)

  // 어느 코드로 들어왔는지. 코드를 여러 명이 쓸 수 있으므로
  // 이게 없으면 "누가 뿌린 코드로 들어온 회원인지" 를 되짚을 수 없다.
  joinedViaInvitationId String?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 초대
  createdInvitations  CenterInvitation[] @relation("CreatedInvitations")
  joinedViaInvitation CenterInvitation?  @relation("JoinedViaInvitation", fields: [joinedViaInvitationId], references: [id], onDelete: SetNull)

  // 센터 공지. 센터가 없으면 공지도 없으므로 여기 남는다.
  authoredNotices Notice[]     @relation("NoticeAuthor")
  noticeReads     NoticeRead[] @relation("NoticeReader")

  @@unique([centerId, userId])
  @@index([centerId, role])
  @@index([centerId, status])
}

// ============================================================
// CENTER INVITATION
// ============================================================

model CenterInvitation {
  id       String @id @default(uuid())
  centerId String

  email String?
  code  String  @unique

  // 실제 API에서 TRAINER / MEMBER만 허용하도록 검증
  role MembershipRole

  // 누가 발급했는지. 관리자가 뿌린 코드인지 트레이너가 뿌린 코드인지를 가른다.
  createdByMembershipId String

  // 회원 코드는 여러 명이 쓰고, 트레이너 코드는 한 명만 쓴다.
  // 회원 100명에게 코드를 100번 발급할 수는 없다.
  maxUses   Int @default(1)
  usedCount Int @default(0)

  expiresAt DateTime
  // 코드가 단톡방에 돌았을 때 끄는 수단. 만료일만으로는 못 막는다.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  center    Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdBy CenterMembership @relation("CreatedInvitations", fields: [createdByMembershipId], references: [id], onDelete: Cascade)

  joinedMemberships CenterMembership[] @relation("JoinedViaInvitation")

  @@index([centerId, role])
  @@index([expiresAt])
  @@index([createdByMembershipId])
}

// ============================================================
// MEMBER PROFILE
// ============================================================

model MemberProfile {
  id     String @id @default(uuid())
  userId String @unique

  birthDate DateTime?
  gender    String?

  heightCm Decimal?

  fitnessLevel String?
  primaryGoal  String?

  onboardingDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  equipment MemberEquipment[]
}

// ============================================================
// TRAINER PROFILE
// ============================================================

/**
 * 트레이너라는 신분.
 * 센터가 아니라 사람에 붙는다. 센터에 매달아 두면 센터 없는 트레이너가 존재할
 * 수 없고, 트레이너가 센터를 옮기는 순간 그가 쌓은 회원 관계와 알림장이 전부
 * 끊긴다. 회원의 여정을 보여주겠다면서 여정이 이직 한 번에 사라지면 앞뒤가
 * 맞지 않는다.
 * 센터 소속 여부는 같은 User 의 CenterMembership 이 있는가로 따로 본다.
 */
model TrainerProfile {
  id     String @id @default(uuid())
  userId String @unique

  // 활동명. 본명과 다르게 쓰는 사람이 있어 따로 둔다. 없으면 User.name 을 쓴다.
  displayName     String?
  bio             String?
  specialty       String?
  careerYears     Int?
  profileImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  connections TrainerMemberConnection[]
  invitations TrainerInvitation[]

  contracts  PTContract[]
  ptSessions PTSession[]
  journals   Journal[]
  ptPrices   TrainerPTPrice[]

  dietFeedbacks   DietFeedback[]
  createdRoutines Routine[]      @relation("TrainerCreatedRoutines")
}

/**
 * 트레이너와 회원의 코칭 관계.
 * PT 관계의 단 하나뿐인 진실이다. 예전에는 CenterMembership 이 자기 자신을
 * 가리켜 담당을 표현했는데, 그러면 센터가 없으면 관계도 없고 센터를 옮기면
 * 관계가 끊겼다.
 * 센터 가입과는 별개다. 센터에만 등록하고 PT 는 안 받는 회원이 정상 상태여야
 * 하는데, 예전 구조에서는 그런 사람이 "담당이 비어 있는 이상한 회원" 이었다.
 */
model TrainerMemberConnection {
  id String @id @default(uuid())

  trainerProfileId String
  memberUserId     String

  status ConnectionStatus @default(ACTIVE)

  /**
   * 이 관계가 어느 센터에서 시작됐는지. 무소속 트레이너면 null.
   * 지금은 쓰지 않지만 나중에 센터가 트레이너 좌석을 결제하는 구조가 되면
   * "센터가 데려온 회원인가, 트레이너가 데려온 회원인가" 를 반드시 묻게 된다.
   * 그때 가서 넣으면 이미 생긴 관계들의 출처를 알 방법이 없다.
   */
  originCenterId String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  memberUser     User           @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  originCenter   Center?        @relation(fields: [originCenterId], references: [id], onDelete: SetNull)

  // 같은 트레이너와 같은 회원이 두 줄을 갖지 않는다. 끊었다 다시 이으면
  // 같은 줄을 ACTIVE 로 되살린다. 새 줄을 만들면 지난 기간이 사라진다.
  @@unique([trainerProfileId, memberUserId])
  @@index([memberUserId, status])
  @@index([trainerProfileId, status])
}

/**
 * 트레이너가 회원을 부르는 코드.
 * 센터 코드와 나눈 이유는 두 코드가 하는 일이 다르기 때문이다. 센터 코드는
 * "이 센터의 회원이 된다" 이고, 트레이너 코드는 "이 트레이너에게 코칭받는다"
 * 이다. 무소속 트레이너에게는 센터가 없어 센터 코드를 만들 수도 없다.
 */
model TrainerInvitation {
  id               String @id @default(uuid())
  trainerProfileId String

  code String @unique

  // 회원 여럿이 같은 코드를 쓴다. 회원 30명에게 코드를 30번 발급할 수는 없다.
  maxUses   Int @default(50)
  usedCount Int @default(0)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@index([trainerProfileId])
  @@index([expiresAt])
}

// ============================================================
// EQUIPMENT
// ============================================================

model Equipment {
  id          String            @id @default(uuid())
  name        String            @unique
  category    EquipmentCategory
  description String?
  imageUrl    String?

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberEquipment   MemberEquipment[]
  exerciseEquipment ExerciseEquipment[]
  gymEquipment      GymEquipment[]

  @@index([category])
  @@index([isActive])
}

// ============================================================
// MEMBER EQUIPMENT
// ============================================================

model MemberEquipment {
  id          String @id @default(uuid())
  memberId    String
  equipmentId String

  available Boolean @default(true)

  // 사용자가 직접 등록한 기구
  isCustom   Boolean @default(false)
  customName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  equipment Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([memberId, equipmentId])
  @@index([memberId, available])
  @@index([equipmentId])
}

// ============================================================
// GYM
// ============================================================

model Gym {
  id       String @id @default(uuid())
  centerId String

  name    String
  address String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center    Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  equipment GymEquipment[]

  @@index([centerId, isActive])
}

// ============================================================
// GYM EQUIPMENT
// ============================================================

model GymEquipment {
  id          String @id @default(uuid())
  gymId       String
  equipmentId String

  available Boolean @default(true)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([gymId, equipmentId])
  @@index([equipmentId])
}

// ============================================================
// EXERCISE
// ============================================================
model Exercise {
  id String @id @default(uuid())

  name String @unique

  bodyPart     WorkoutBodyPart
  targetMuscle String?

  movementType ExerciseMovementType
  difficulty   Difficulty

  description String?
  instruction String?
  breathing   String?
  caution     String?

  videoUrl     String?
  thumbnailUrl String?

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment ExerciseEquipment[]

  alternativesFrom WorkoutAlternative[] @relation("AlternativeFrom")
  alternativesTo   WorkoutAlternative[] @relation("AlternativeTo")

  routineExercises RoutineExercise[]

  workoutRecords WorkoutRecord[]
  favorites      WorkoutFavorite[]

  @@index([bodyPart, isActive])
  @@index([difficulty])
  @@index([movementType])
}

// ============================================================
// EXERCISE ↔ EQUIPMENT
// ============================================================

model ExerciseEquipment {
  id          String @id @default(uuid())
  exerciseId  String
  equipmentId String

  isPrimary Boolean @default(false)

  exercise  Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([exerciseId, equipmentId])
  @@index([equipmentId, exerciseId])
}

// ============================================================
// EXERCISE ALTERNATIVE
// ============================================================

model WorkoutAlternative {
  id String @id @default(uuid())

  exerciseId            String
  alternativeExerciseId String

  type     AlternativeType
  priority Int             @default(0)
  reason   String?

  exercise Exercise @relation("AlternativeFrom", fields: [exerciseId], references: [id], onDelete: Cascade)

  alternativeExercise Exercise @relation("AlternativeTo", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, alternativeExerciseId])
  @@index([exerciseId, type])
  @@index([alternativeExerciseId])
}

// ============================================================
// ROUTINE
// ============================================================

model Routine {
  id     String @id @default(uuid())
  userId String

  name        String
  description String?

  status RoutineStatus @default(ACTIVE)

  // 트레이너가 만들어 준 루틴인 경우
  createdByTrainerProfileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdByTrainer TrainerProfile? @relation("TrainerCreatedRoutines", fields: [createdByTrainerProfileId], references: [id], onDelete: SetNull)

  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@index([userId, status])
  @@index([createdByTrainerProfileId])
}

// ============================================================
// ROUTINE EXERCISE
// ============================================================

model RoutineExercise {
  id         String @id @default(uuid())
  routineId  String
  exerciseId String

  orderIndex Int

  targetSets   Int?
  targetReps   Int?
  targetWeight Decimal?
  restSeconds  Int?

  note String?

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([routineId, orderIndex])
  @@index([routineId])
  @@index([exerciseId])
}

// ============================================================
// WORKOUT SESSION
// ============================================================

model WorkoutSession {
  id     String @id @default(uuid())
  userId String

  routineId String?

  startedAt DateTime
  endedAt   DateTime?

  durationSec Int?

  status WorkoutSessionStatus @default(IN_PROGRESS)

  entryMode WorkoutEntryMode @default(LIVE)

  /**
   * PT 수업이면 그 수업. 없으면 개인 운동.
   * 운동 하나하나가 아니라 세션에 붙인다. "누가 적었나"(recordedByUserId)가
   * 이미 세션 단위여서, PT 여부만 운동 단위로 두면 트레이너가 적어 준 세션에
   * PT 가 아닌 운동이 섞이는 설명할 수 없는 상태가 생긴다.
   * PT 를 받고 남아서 혼자 유산소를 하면 세션이 나뉜다. 하루에 세션이 여러 개인
   * 것은 이미 지원한다.
   */
  ptSessionId String? @unique

  // 누가 입력했는지. null 이면 본인.
  //
  // entryMode 와는 다른 축이다. entryMode 는 "어떻게"(실시간/몰아서),
  // 이건 "누가". 트레이너가 PT 수업을 실시간으로 적어 주는 경우가 있으므로
  // 하나로 합칠 수 없다.
  //
  // 기록의 주인은 어디까지나 userId 의 회원이다. 트레이너 계정이 사라져도
  // 회원의 기록은 남아야 하므로 SetNull.
  recordedByUserId String?

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  recordedBy User? @relation("WorkoutSessionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  ptSession PTSession? @relation(fields: [ptSessionId], references: [id], onDelete: SetNull)

  records WorkoutRecord[]

  @@index([userId, startedAt])
  // 진행중 LIVE 세션 조회 전용. entryMode 까지 넣어야 몰아서 입력하는 중인
  // MANUAL 세션을 건너뛰는 비용이 없다.
  @@index([userId, status, entryMode])
  @@index([routineId])
  // 트레이너 화면: "내가 적어 준 기록"
  @@index([recordedByUserId, startedAt])
}

// ============================================================
// WORKOUT RECORD
// ============================================================

model WorkoutRecord {
  id         String @id @default(uuid())
  sessionId  String
  exerciseId String

  // 세션의 소유자를 복사해 둔다.
  // "내 벤치프레스 직전 기록" / PR 판정은 운동을 추가할 때마다 호출되는
  // hot path 인데, 세션까지 조인하면 전체 사용자의 기록을 훑게 된다.
  userId String

  orderIndex Int @default(0)

  note String?

  // 해당 운동의 총 볼륨
  totalVolume Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  sets WorkoutSet[]

  @@index([sessionId, orderIndex])
  // 이전 기록 조회 / PR 판정 전용
  @@index([userId, exerciseId, createdAt(sort: Desc)])
  // exerciseId 단독 조회(Exercise 삭제 시 Restrict 검사, 전체 통계)를 위해 유지
  @@index([exerciseId, createdAt])
}

// ============================================================
// WORKOUT SET
// ============================================================

model WorkoutSet {
  id String @id @default(uuid())

  recordId  String
  setNumber Int

  weight Decimal?
  reps   Int?

  restSeconds Int?

  completed Boolean @default(true)

  rpe  Decimal?
  note String?

  createdAt DateTime @default(now())

  record WorkoutRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, setNumber])
  @@index([recordId])
}

// ============================================================
// WORKOUT FAVORITE
// ============================================================

model WorkoutFavorite {
  id         String @id @default(uuid())
  userId     String
  exerciseId String

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, createdAt])
}

// ============================================================
// PT PRODUCT
// ============================================================

model PTProduct {
  id       String @id @default(uuid())
  centerId String

  name        String
  description String?

  basePrice    Decimal
  sessionCount Int
  durationDays Int?

  isTrial Boolean @default(false)

  status PTProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  trainerPrices TrainerPTPrice[]
  contracts     PTContract[]

  @@index([centerId, status])
}

// ============================================================
// TRAINER PT PRICE
// ============================================================

/**
 * 수업을 미룬 이력.
 * 상태로 만들지 않았다. 미룬 수업은 여전히 "앞으로 할 수업" 이라 SCHEDULED 로
 * 남아야 하고, POSTPONED 같은 상태를 두면 다음 수업 목록에서 조용히 빠진다.
 * 화면의 "🔄 일정 변경" 줄은 상태가 아니라 여기 쌓인 이력이다.
 */
model PTSessionReschedule {
  id        String @id @default(uuid())
  sessionId String

  fromScheduledAt DateTime
  toScheduledAt   DateTime

  movedBy PTSessionActor
  reason  String?

  createdAt DateTime @default(now())

  session PTSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model TrainerPTPrice {
  id String @id @default(uuid())

  trainerProfileId String
  productId        String

  price Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  product PTProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, productId])
  @@index([productId])
}

// ============================================================
// PT CONTRACT
// ============================================================

model PTContract {
  id String @id @default(uuid())

  memberUserId     String
  trainerProfileId String

  /**
   * 센터가 파는 상품에서 나온 계약인지. 개인 트레이너면 null.
   * 예전에는 이 값이 필수였다. 그런데 PTProduct 는 센터의 것이라, 상품을
   * 반드시 거치게 하면 혼자 하는 트레이너는 센터를 먼저 만들지 않고서는
   * "김수정 / 20회 / 9월~12월" 조차 등록할 수 없었다. 계약이 스스로 설 수
   * 있어야 한다. 이름과 횟수를 계약이 직접 든 이유다.
   */
  productId String?

  /**
   * 이 계약이 어느 센터에서 맺어졌는지. 개인 트레이너면 null.
   * 관계가 시작된 센터(TrainerMemberConnection.originCenterId)와 다를 수 있다.
   * 트레이너가 이직한 뒤 같은 회원과 새로 맺은 계약은 새 센터의 것이다.
   * 나중에 센터가 "우리 센터에서 나간 PT" 를 셀 때 이 값이 없으면 답할 수 없다.
   */
  centerId String?

  /**
   * 이 계약을 부르는 이름. "PT 20회", "재활 3개월" 처럼.
   * 예전 이름은 productNameSnapshot 이었는데, 상품을 거치지 않게 된 지금은
   * 거짓말이다. 비워 두면 횟수로 자동으로 채운다.
   */
  title String

  totalSessions Int
  usedSessions  Int @default(0)

  startedAt DateTime
  expiresAt DateTime?

  status PTContractStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberUser     User           @relation("ContractMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)

  // 센터가 문을 닫아도 계약 기록은 남는다. 회원의 운동 이력이기도 하다.
  center Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  product PTProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sessions PTSession[]

  @@index([memberUserId, status])
  @@index([trainerProfileId, status])
  @@index([centerId, status])
  @@index([productId])
  @@index([expiresAt])
}

// ============================================================
// PT SESSION
// ============================================================

model PTSession {
  id String @id @default(uuid())

  contractId String

  memberUserId     String
  trainerProfileId String

  sessionNumber Int

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  status PTSessionStatus @default(SCHEDULED)

  /**
   * 이 회차가 계약 횟수를 깎았는가.
   * 상태에서 파생하지 않고 그때 박아 둔다. 노쇼를 차감할지는 트레이너마다
   * 다르고 도중에 바뀌는데, 파생해서 세면 정책을 바꾼 순간 지난 계약의 남은
   * 횟수까지 소리 없이 달라진다. 그때 어떻게 했는지는 그때 남겨야 한다.
   */
  deducted Boolean @default(false)

  memo String?

  completedAt DateTime?

  cancelledAt  DateTime?
  cancelledBy  PTSessionActor?
  cancelReason String?

  /**
   * 회원이 아직 확인하지 못한 일정 변경이 있으면 그 시각. 확인하면 다시 null.
   *
   * 트레이너가 수업을 잡거나 옮기거나 취소하면 회원은 알 길이 없었다. 홈의
   * 다가오는 수업 목록에서 시간이 조용히 바뀌고, 취소된 수업은 그냥 사라진다.
   * 회원은 원래 시각에 헬스장에 간다.
   *
   * 별도의 알림 테이블을 두지 않은 이유는, 알림장·공지가 이미 각자 읽음을
   * 들고 있어서(Journal.memberReadAt · NoticeRead) 세 번째 읽음 장부가
   * 생기면 같은 사건이 한쪽에서만 지워지는 상태가 반드시 생기기 때문이다.
   * 알릴 것이 수업 일정 하나뿐인 동안은 수업이 직접 들고 있는 게 맞다.
   *
   * 값을 지우는(=null) 방식이라 "무엇이" 바뀌었는지는 안 남지만, 그 이력은
   * PTSessionReschedule 과 cancelledAt 에 이미 있다.
   */
  memberAlertAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract PTContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  memberUser     User           @relation("PTSessionMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)

  workoutSession WorkoutSession?
  journals       Journal[]
  reschedules    PTSessionReschedule[]

  @@unique([contractId, sessionNumber])
  @@index([trainerProfileId, scheduledAt])
  @@index([memberUserId, scheduledAt])
  @@index([status, scheduledAt])
}

// ============================================================
// DIET RECORD
// ============================================================

model DietRecord {
  id     String @id @default(uuid())
  userId String

  date     DateTime
  mealType DietMealType

  foodName String?
  amount   String?

  calories     Decimal?
  carbohydrate Decimal?
  protein      Decimal?
  fat          Decimal?

  memo String?

  // 음식 사진. 버킷이 비공개라 주소가 아니라 저장소 안의 경로를 담는다.
  // 주소는 열 때마다 짧게 사는 서명 주소를 새로 만든다.
  //
  // 한 끼에 한 장이다. 한 끼는 결국 한 상이라 여러 장이 필요한 일이 드물고,
  // 별도 표로 빼면 사진 없는 기록이 대부분인데도 매번 조인하게 된다.
  imagePath     String?
  thumbnailPath String?

  // 추후 AI 음식 분석.
  //
  // 칼로리 · 탄단지 칸을 등록 폼에서 받지 않는 이유가 여기 있다. 끼니마다 숫자
  // 넷을 손으로 적게 하면 사흘 만에 안 올린다. 지금은 사진과 메모만 받고,
  // 숫자는 나중에 분석이나 외부 식단 앱 연동으로 채운다.
  aiAnalyzed Boolean @default(false)
  aiResult   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  feedbacks DietFeedback[]

  @@index([userId, date])
  @@index([userId, mealType])
}

// ============================================================
// DIET FEEDBACK
// ============================================================

model DietFeedback {
  id String @id @default(uuid())

  dietRecordId     String
  trainerProfileId String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dietRecord DietRecord @relation(fields: [dietRecordId], references: [id], onDelete: Cascade)

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)

  @@index([dietRecordId, createdAt])
  @@index([trainerProfileId, createdAt])
}

// ============================================================
// BODY RECORD
// ============================================================

/**
 * 회원이 재는 몸.
 * 하루에 한 줄만 둔다. recordedAt 은 KST 그 날 0시로 맞춰 넣는다. 아침에 재고
 * 저녁에 또 재면 그래프가 톱니가 되는데, 체중은 하루 안에서도 1~2kg 이 움직여서
 * 그 톱니가 실제 변화보다 커 보인다. 같은 날 다시 적으면 덮어쓴다.
 */
model BodyRecord {
  id     String @id @default(uuid())
  userId String

  recordedAt DateTime

  weightKg         Decimal?
  bodyFatPercent   Decimal?
  skeletalMuscleKg Decimal?
  waistCm          Decimal?

  memo     String?
  imageUrl String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedAt])
  @@index([userId, recordedAt])
}

// ============================================================
// GOAL
// ============================================================

model Goal {
  id     String @id @default(uuid())
  userId String

  type GoalType

  title       String
  description String?

  targetValue Decimal?
  /**
   * 목표를 세울 때의 값.
   * 파생하지 않고 그때 박는다. "startDate 이전의 가장 최근 기록" 으로 계산하면
   * 나중에 빠뜨린 과거 기록을 하나 넣는 순간 시작값이 바뀌고, 그러면 진행률이
   * 소리 없이 달라진다. 시작값은 "그때 나는 78kg 이었다" 는 사실이다.
   * 지금 값은 반대로 저장하지 않는다. 최신 BodyRecord 에서 읽는다. 저장하면
   * 회원이 체중을 새로 적는 순간 목표 카드만 옛날 숫자로 남는다.
   */
  startValue  Decimal?
  unit        String?

  startDate  DateTime
  targetDate DateTime?

  status GoalStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, targetDate])
}

// ============================================================
// JOURNAL
// ============================================================

model Journal {
  id String @id @default(uuid())

  memberUserId     String
  trainerProfileId String

  ptSessionId String?

  date DateTime

  title   String?
  content String

  status JournalStatus @default(DRAFT)

  workoutSummary String?
  dietGuidance   String?
  caution        String?
  nextGoal       String?

  publishedAt DateTime?

  /**
   * 회원이 읽은 시각.
   * 이게 없으면 홈의 "오늘 확인할 것" 을 고를 수 없다. 안 읽은 것을 세는 게
   * 아니라 "무엇을 보여줄지" 를 정하는 데 쓴다.
   */
  memberReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberUser     User           @relation("JournalMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)

  ptSession PTSession? @relation(fields: [ptSessionId], references: [id], onDelete: SetNull)

  photos   JournalPhoto[]
  comments JournalComment[]

  @@index([memberUserId, date])
  @@index([trainerProfileId, date])
  @@index([ptSessionId])
  @@index([status, publishedAt])
  // 회원 홈: 아직 안 읽은 알림장
  @@index([memberUserId, memberReadAt])
}

model JournalPhoto {
  id        String @id @default(uuid())
  journalId String

  /**
   * 저장소 안의 경로. 주소가 아니다.
   * 비공개 버킷이라 주소는 볼 때마다 서명해서 만든다. 서명된 주소를 저장하면
   * 한 시간 뒤에 죽은 값이 DB 에 남는다.
   */
  storagePath String

  // 목록에서 작게 보여줄 때 쓴다. 원본을 받으면 목록 한 번에 수 MB 가 나간다.
  thumbnailPath String?

  orderIndex Int @default(0)

  createdAt DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId, orderIndex])
}

/**
 * 알림장 댓글.
 * 식단 댓글(DietFeedback)과 합치지 않았다. 대상이 다른 댓글을 한 테이블에 담으려면
 * (targetType, targetId) 로 가리켜야 하는데 그러면 외래키를 걸 수 없어서, 알림장을
 * 지워도 댓글이 남는다.
 */
model JournalComment {
  id        String @id @default(uuid())
  journalId String

  // 트레이너와 회원이 같은 표에 쓴다. 둘의 공통 신분은 User 뿐이라 여기에 건다.
  // 트레이너가 쓴 글인지는 알림장의 trainerProfile.userId 와 견줘서 안다.
  authorUserId String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 지우면 대화가 끊기므로 남긴다.
  deletedAt DateTime?

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  author User @relation("JournalCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([journalId, createdAt])
  @@index([authorUserId])
}

// ============================================================
// NOTICE
// ============================================================

/**
 * 공지사항.
 * 알림장이 한 회원에게 가는 글이라면 이건 여러 명에게 간다. 대상을 회원 목록으로
 * 펼쳐 저장하지 않는다. 회원이 늘거나 나갈 때마다 대상을 고쳐야 하기 때문이다.
 * 대신 범위만 저장하고 읽을 때 계산한다.
 */
model Notice {
  id       String @id @default(uuid())
  centerId String

  authorMembershipId String

  scope NoticeScope @default(CENTER)

  title   String
  content String

  // 목록 맨 위에 고정.
  pinnedAt DateTime?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  authorMembership CenterMembership @relation("NoticeAuthor", fields: [authorMembershipId], references: [id], onDelete: Restrict)

  reads NoticeRead[]

  @@index([centerId, publishedAt])
  @@index([authorMembershipId])
}

model NoticeRead {
  id       String @id @default(uuid())
  noticeId String

  membershipId String

  readAt DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  membership CenterMembership @relation("NoticeReader", fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([noticeId, membershipId])
  @@index([membershipId])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id     String @id @default(uuid())
  userId String

  type    NotificationType
  title   String
  message String

  relatedType String?
  relatedId   String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// AI ANALYSIS
// ============================================================

model AiAnalysis {
  id     String @id @default(uuid())
  userId String

  type   String
  status AiAnalysisStatus @default(PENDING)

  inputData  Json?
  resultData Json?

  errorMessage String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
  @@index([createdAt])
}

/**
 * 회원이 담당 트레이너에게 무엇까지 보여줄지.
 * 회원 계정에 붙인다. 예전에는 센터 소속에 붙였는데, 이제 코칭 관계가 센터와
 * 무관하게 이어지므로 소속에 매달면 센터를 옮길 때마다 설정이 초기화된다.
 * 켜 둔 줄 알았던 것이 조용히 꺼지는 쪽이, 지난 설정이 따라오는 것보다 나쁘다.
 * 트레이너를 여럿 두게 되면 이 표가 연결(TrainerMemberConnection)로 내려간다.
 * PT 수업 기록은 여기에 없다. 그건 트레이너가 직접 적은 것이라 회원이
 * 가릴 대상이 아니다. 회원이 스스로 남긴 것만 고를 수 있게 한다.
 */
model TrainerSharingSetting {
  id     String @id @default(uuid())
  userId String @unique

  /**
   * 식단은 기본으로 켠다.
   * 회원이 식단을 올리는 이유가 대개 피드백을 받기 위해서다. 기본이 꺼져
   * 있으면 올려 두고 "왜 답이 없지" 하게 된다.
   */
  shareDiet      Boolean @default(true)
  shareDietPhoto Boolean @default(true)

  /**
   * 개인 운동과 체중은 기본으로 끈다.
   * 혼자 한 운동과 몸무게는 보여주려고 적는 게 아니다. 켜는 건 회원이
   * 정하게 한다.
   */
  sharePersonalWorkout Boolean @default(false)
  shareBody            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
